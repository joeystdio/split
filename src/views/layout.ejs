<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>Split</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <a href="/" class="logo">🍽️ Split</a>
    <% if (typeof user !== 'undefined' && user) { %>
      <span class="user-info">
        <%= user.username || user.email %>
        <a href="https://auth.jdms.nl/logout?redirect=https://split.jdms.nl" class="btn btn-small">Logout</a>
      </span>
    <% } %>
  </nav>
  <main class="container">
    <%- body %>
  </main>
  <script src="/js/app.js"></script>
</body>
</html>
